{
  "name": "lockersm",
  "version": "2.0.0",
  "description": "Official Locker Secrets SDK for Node.js",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/esm/types/index.d.ts",
        "default": "./lib/esm/index.js"
      },
      "require": {
        "types": "./lib/cjs/types/index.d.ts",
        "default": "./lib/cjs/index.js"
      }
    }
  },
  "types": "./lib/cjs/types/index.d.ts",
  "main": "./lib/cjs/index.js",
  "module": "./lib/esm/index.js",
  "bin": {
    "lockersm-install": "./setup.js"
  },
  "files": [
    "lib/**/*",
    "protocol/**/*",
    "scripts/install-cli.mjs",
    "locker-cli-release.json",
    "setup.js"
  ],
  "engines": {
    "node": "^22.20.0 || ^24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://git.cystack.org/locker/secrets-sdk/js.git"
  },
  "homepage": "https://locker.io",
  "bugs": {
    "url": "https://git.cystack.org/locker/secrets-sdk/js/-/issues"
  },
  "scripts": {
    "clean": "node ./scripts/clean.mjs",
    "build": "node ./scripts/build.mjs",
    "ci:contract": "node ./scripts/verify-ci-supply-chain.mjs",
    "build:esm": "tsc -p ./configs/tsconfig.esm.json",
    "build:cjs": "tsc -p ./configs/tsconfig.cjs.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p ./configs/tsconfig.esm.json --noEmit && tsc -p ./configs/tsconfig.cjs.json --noEmit && tsc -p ./configs/tsconfig.tests.json",
    "prepack": "npm run build",
    "test": "npm run build && node ./scripts/test.mjs",
    "install:cli": "node setup.js"
  },
  "author": "CyStack",
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "^22.15.3",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  }
}
